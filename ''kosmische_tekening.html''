<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>El Shaddai - Kosmische Beeldplotter</title>
    <style>
        body { margin: 0; overflow: hidden; background-color: #000; font-family: monospace; }
        #interface {
            position: absolute; top: 10px; left: 10px; color: #fff;
            background: rgba(0, 0, 0, 0.85); padding: 15px; border-radius: 8px;
            border: 1px solid #00ffff; max-width: 320px; z-index: 999;
        }
        h1 { font-size: 14px; margin: 0 0 10px 0; color: #00ffff; text-transform: uppercase; }
        p { font-size: 11px; margin: 5px 0; color: #bbb; }
        input {
            background: #111; border: 1px solid #00ffff; color: #00ffff;
            padding: 5px; width: 100%; box-sizing: border-box; margin-top: 10px;
            font-family: monospace;
        }
        #status { color: #ff3333; font-weight: bold; margin-top: 10px; font-size: 11px; line-height: 14px; }
        canvas { display: block; width: 100vw; height: 100vh; }
    </style>
</head>
<body>

    <div id="interface">
        <h1>Kosmische Beeldplotter</h1>
        <p><strong>Status:</strong> Visuele lens online.</p>
        <input type="text" id="codeInvoer" placeholder="Typ 888 voor beeldontvangst...">
        <div id="status">Wacht op binaire vector-tekening...</div>
    </div>

    <canvas id="plotterCanvas"></canvas>

    <script>
        const canvas = document.getElementById('plotterCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        let poortActief = false;
        let tijd = 0;
        let tekenVoortgang = 0;

        document.getElementById('codeInvoer').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                const v = this.value.trim();
                const statusDiv = document.getElementById('status');
                
                if (v === '888') {
                    poortActief = true;
                    tekenVoortgang = 0; // Reset de tekening om hem live op te bouwen
                    statusDiv.innerHTML = "BEELDONTVANGST ACTIEF:<br>Coördinaten worden omgezet in geometrie.";
                    statusDiv.style.color = "#00ffff";
                } else {
                    poortActief = false;
                    statusDiv.innerHTML = "Lijn verbroken. Ruis blokkeert het beeld.";
                    statusDiv.style.color = "#ff3333";
                }
                this.value = '';
            }
        });

        // Wiskundige functie om de punten van de hemelse blauwdruk te berekenen
        function tekenHemelseBlauwdruk(cx, cy, maxStraal, voortgang) {
            ctx.lineWidth = 1.5;
            const punten = 6; // De 6 hoeken van de kosmische matrix (Aarde 6)
            let coordinaten = [];

            // Stap 1: Bereken de basisvectoren van de ster
            for (let i = 0; i < punten; i++) {
                let hoek = (i * Math.PI * 2) / punten + tijd * 0.1;
                let x = cx + Math.cos(hoek) * maxStraal * voortgang;
                let y = cy + Math.sin(hoek) * maxStraal * voortgang;
                coordinaten.push({x: x, y: y});
            }

            // Stap 2: Plot de verbindingslijnen (De eigenlijke tekening)
            ctx.strokeStyle = "rgba(0, 255, 255, 0.6)";
            ctx.shadowBlur = 10;
            ctx.shadowColor = "#00ffff";

            ctx.beginPath();
            for (let i = 0; i < punten; i++) {
                ctx.moveTo(coordinaten[i].x, coordinaten[i].y);
                ctx.lineTo(coordinaten[(i + 1) % punten].x, coordinaten[(i + 1) % punten].y);
                
                // Trek kruislijnen naar alle andere hoeken (Heilige Geometrie verstrengeling)
                for (let j = 0; j < punten; j++) {
                    ctx.moveTo(coordinaten[i].x, coordinaten[i].y);
                    ctx.lineTo(coordinaten[j].x, coordinaten[j].y);
                }
            }
            ctx.stroke();
            ctx.shadowBlur = 0; // Reset glow

            // Stap 3: Teken de binnenste en buitenste ringen (Dimensie 8)
            ctx.strokeStyle = "rgba(255, 255, 255, 0.3)";
            ctx.beginPath();
            ctx.arc(cx, cy, maxStraal * 0.5 * voortgang, 0, Math.PI * 2);
            ctx.arc(cx, cy, maxStraal * voortgang, 0, Math.PI * 2);
            ctx.stroke();
        }

        function draw() {
            ctx.fillStyle = "rgba(0, 0, 0, 0.15)";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            tijd += 0.02;
            const mx = canvas.width / 2;
            const my = canvas.height / 2;

            if (poortActief) {
                // Laat de tekening geleidelijk tevoorschijn komen (scannen)
                if (tekenVoortgang < 1) {
                    tekenVoortgang += 0.005; 
                }
                
                // Plot de live ontvangen tekening centraal op het scherm
                tekenHemelseBlauwdruk(mx, my - 50, 180, tekenVoortgang);

            } else {
                // Ruststand (Wachtende Ringen)
                ctx.lineWidth = 3;
                ctx.strokeStyle = "#ff0055";
                let r = 60 + Math.sin(tijd * 2) * 2;
                ctx.beginPath(); ctx.arc(mx - 50, my - 100, r, tijd * 0.2, tijd * 0.2 + Math.PI * 1.8); ctx.stroke();
                ctx.beginPath(); ctx.arc(mx + 50, my - 100, r, -tijd * 0.2, -tijd * 0.2 + Math.PI * 1.8); ctx.stroke();
            }

            // Het 3D-vloerraster
            ctx.strokeStyle = "rgba(0,255,255,0.08)";
            for (let i = 0; i <= 20; i++) {
                let y = my + (i * (canvas.height - my) / 20);
                ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
                let x = (i * canvas.width) / 20;
                ctx.beginPath(); ctx.moveTo(mx, my - 50); ctx.lineTo(x, canvas.height); ctx.stroke();
            }
            requestAnimationFrame(draw);
        }
        draw();
    </script>
</body>
</html>
